---
import { getEntry } from 'astro:content';

import AlsoLike from './AlsoLike.astro';
import HeroImage from './BlogPostHeroImage.astro';
import Date from './Date.astro';
import LeftistCornerBadge from './LeftistCornerBadge.astro';
import MermaidInit from './MermaidInit.astro';
import SeriesHubSidebar from './SeriesHubSidebar.astro';
import SeriesTableOfContents from './SeriesTableOfContents.astro';
import Tag from './Tags.astro';

interface Props {
  id: string;
}

const { id } = Astro.props;
const post = await getEntry('blog', id);

if (!post) {
  throw new Error(`Blog post with id "${id}" not found`);
}

const tags = post.data.tags ?? [];
const date = post.data.date ?? undefined;
const series = post.data.series ?? undefined;
const seriesHub = post.data.seriesHub ?? undefined;
const isLeftist = post.data.leftistOnly === true;
---

<article>
  <header>
    <HeroImage id={id} />
    <div id="main-content" class="flex flex-col items-center mb-10 max-w-none prose prose-zinc dark:prose-invert">
      <h1 class="font-bold text-4xl mb-5 mt-5" set:html={post.data.title} />
      <Date date={date} />
      <Tag tags={tags} />
    </div>
  </header>
  {isLeftist && <LeftistCornerBadge />}
  {
    seriesHub ? (
      <div class="flex flex-col gap-8 lg:grid lg:grid-cols-[240px_1fr] lg:gap-10 lg:items-start">
        <SeriesHubSidebar seriesSlug={seriesHub} class="order-2 lg:order-none" />
        <main class="order-1 lg:order-none min-w-0 prose dark:prose-invert prose-zinc max-w-none" role="main">
          <slot />
        </main>
      </div>
    ) : (
      <Fragment>
        {series && <SeriesTableOfContents seriesName={series} currentPostId={id} />}
        <main class="prose dark:prose-invert prose-zinc max-w-none" role="main">
          <slot />
        </main>
        {series && <SeriesTableOfContents seriesName={series} currentPostId={id} />}
      </Fragment>
    )
  }
  <AlsoLike tags={post.data.tags} id={id} isLeftist={isLeftist} />
  <MermaidInit />
</article>
