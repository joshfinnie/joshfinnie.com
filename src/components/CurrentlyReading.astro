---
import MCBookOpen from '@icons/mc_book_open_line.svg';
import MCClose from '@icons/mc_close_line.svg';
import MCStar from '@icons/mc_star_line.svg';
---

<div
  x-data="{
    book: null,
    loading: true,
    dismissed: true,
    revealed: false,
    get progressPct() {
      const pages = this.book?.pages ?? 0;
      const read = this.book?.progressPages ?? 0;
      return pages > 0 ? Math.round((read / pages) * 100) : 0;
    },
    async init() {
      try {
        const res = await fetch('/.netlify/functions/currently-reading');
        if (res.ok) this.book = await res.json();
      } catch {}
      this.loading = false;
      if (this.book) {
        this.dismissed = localStorage.getItem('currently-reading-dismissed-for') === this.book.slug;
        setTimeout(() => { this.revealed = true; }, 600);
      }
    },
    dismiss() {
      this.dismissed = true;
      if (this.book) localStorage.setItem('currently-reading-dismissed-for', this.book.slug);
    }
  }"
  x-show="!loading && book && !dismissed && revealed"
  x-transition:enter="transition ease-out duration-300"
  x-transition:enter-start="opacity-0 translate-y-2"
  x-transition:enter-end="opacity-100 translate-y-0"
  x-transition:leave="transition ease-in duration-150"
  x-transition:leave-start="opacity-100"
  x-transition:leave-end="opacity-0"
  style="display:none"
  class="fixed bottom-4 right-4 z-40 w-[calc(100%-2rem)] sm:w-72 rounded-lg border border-zinc-200 bg-white p-4 shadow-lg shadow-zinc-800/5 ring-1 ring-zinc-900/5 dark:border-zinc-700 dark:bg-zinc-900 dark:ring-white/10"
>
  <div class="flex items-center justify-between mb-3">
    <h2 class="flex items-center text-xs font-medium uppercase tracking-wide text-zinc-500 dark:text-zinc-400">
      <MCBookOpen class="block h-4 w-4" />
      <span class="ml-2">Currently Reading</span>
    </h2>
    <button
      type="button"
      @click="dismiss()"
      aria-label="Dismiss currently reading"
      class="-m-1 p-1 text-zinc-400 hover:text-zinc-600 dark:text-zinc-500 dark:hover:text-zinc-300 transition"
    >
      <MCClose class="block h-4 w-4" />
    </button>
  </div>

  <a
    :href="`https://hardcover.app/books/${book?.slug}`"
    target="_blank"
    rel="noopener noreferrer"
    class="flex gap-4 items-start group"
  >
    <img
      :src="book?.imageUrl"
      :alt="`Cover of ${book?.title}`"
      class="w-12 rounded ring-1 ring-zinc-900/5 dark:ring-white/10 flex-shrink-0"
      style="aspect-ratio: 2/3"
      loading="lazy"
    />
    <div class="flex flex-col gap-2 min-w-0">
      <p
        x-text="book?.title"
        class="text-sm text-zinc-600 dark:text-zinc-400 leading-snug group-hover:text-zinc-900 dark:group-hover:text-zinc-100 transition"
      ></p>
      <span x-show="book?.rating" class="flex items-center gap-1 text-xs text-zinc-500 dark:text-zinc-400">
        <MCStar class="h-3.5 w-3.5 text-amber-400 flex-shrink-0" />
        <span x-text="book?.rating?.toFixed(2)"></span>
        <span x-show="book?.ratingCount" x-text="`(${book?.ratingCount?.toLocaleString()} ratings)`"></span>
      </span>
      <div x-show="progressPct > 0" class="flex items-center gap-2">
        <div class="flex-1 h-1.5 bg-zinc-100 dark:bg-zinc-700 rounded-full overflow-hidden">
          <div
            class="h-full bg-amber-400 rounded-full transition-all duration-500"
            :style="`width: ${progressPct}%`"
          ></div>
        </div>
        <span x-text="`${progressPct}%`" class="text-xs text-zinc-400 dark:text-zinc-500 tabular-nums"></span>
      </div>
    </div>
  </a>
</div>
