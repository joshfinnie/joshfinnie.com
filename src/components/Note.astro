---
import { getEntry } from 'astro:content';

import MermaidInit from './MermaidInit.astro';
import NoteTags from './NoteTags.astro';

interface Props {
  id: string;
}

const { id } = Astro.props;
const note = await getEntry('note', id);

if (!note) {
  throw new Error(`Note with id "${id}" not found`);
}

let schema = JSON.stringify({
  '@context': 'https://schema.org/',
  '@type': 'BlogPosting',
  headline: note.data.title,
  author: {
    '@type': 'Person',
    name: 'Josh Finnie',
  },
  datePublished: note.data.date,
  dateCreated: note.data.date,
  dateModified: note.data.date,
  description: note.data.description,
  url: `https://www.joshfinnie.com/notes/${note.id}/`,
  inLanguage: 'en-US',
  keywords: note.data.tags,
});
---

<article>
  <header>
    <div id="main-content" class="flex flex-col items-center mb-10 max-w-none prose prose-zinc dark:prose-invert">
      <p class="text-sm font-medium text-zinc-500 dark:text-zinc-400 mb-0 mt-5">
        <a href="/notes/" class="no-underline hover:text-teal-500 dark:hover:text-teal-400 transition">Notes</a>
      </p>
      <h1 class="font-bold text-4xl mb-5 mt-2 text-center" set:html={note.data.title} />
      <NoteTags tags={note.data.tags} />
    </div>
  </header>
  <main class="prose dark:prose-invert prose-zinc max-w-none" role="main">
    <slot />
    {
      note.data.source && (
        <p class="text-sm text-zinc-500 dark:text-zinc-400">
          Source:{' '}
          <a href={note.data.source} target="_blank" rel="noopener noreferrer">
            {note.data.source}
          </a>
        </p>
      )
    }
  </main>
  <MermaidInit />
  <script type="application/ld+json" set:html={schema} is:inline />
</article>
