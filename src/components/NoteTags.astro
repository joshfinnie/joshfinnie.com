---
import BCTags from '@icons/mc_tag_line.svg';

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <div class="flex gap-1 items-center text-sm text-zinc-500 dark:text-zinc-400">
      <BCTags style="display:inline-block" class="h-4 w-4" aria-hidden="true" />
      {tags.map((tag: string, idx: number) => (
        <Fragment key={tag}>
          <a href={`/notes/tags/${tag.trim()}/`} class="hover:text-teal-500 dark:hover:text-teal-400 transition">
            {tag.trim()}
          </a>
          {idx !== tags.length - 1 ? "," : ""}
        </Fragment>
      ))}
    </div>
  )
}
