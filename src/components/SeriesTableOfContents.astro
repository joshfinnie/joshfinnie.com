---
import MCBriefcase from '@icons/mc_briefcase_line.svg';
import { getSeriesEntries } from '@lib/utils';

interface Props {
  seriesName: string;
  currentPostId: string;
}

const { seriesName, currentPostId } = Astro.props;

// Query all entries in the series (blog posts and/or seriesPart entries)
const seriesPosts = await getSeriesEntries(seriesName);

const currentIndex = seriesPosts.findIndex((entry) => entry.id === currentPostId);
const totalPosts = seriesPosts.length;
const currentPartNumber = currentIndex + 1;

// Format series name for display (kebab-case to Title Case)
const displayName = seriesName
  .split('-')
  .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
  .join(' ');
---

{
  seriesPosts.length > 1 && (
    <aside class="my-8 rounded-lg border border-zinc-200 dark:border-zinc-700/40 p-6 bg-zinc-50 dark:bg-zinc-800/50">
      <div class="prose prose-zinc dark:prose-invert max-w-none">
        <h3 class="text-lg font-semibold mb-2 mt-0 flex items-center gap-2">
          <MCBriefcase class="h-5 w-5" style="display:inline-block" />
          Series: {displayName}
        </h3>
        <p class="text-sm text-zinc-600 dark:text-zinc-400 mb-4 mt-2">
          Part {currentPartNumber} of {totalPosts}
        </p>
        <ol reversed class="list-decimal list-inside space-y-2 pl-0 mt-4 mb-2">
          {[...seriesPosts].reverse().map((entry) =>
            entry.id === currentPostId ? (
              <li class="font-bold text-zinc-900 dark:text-zinc-100">
                <span class="inline-flex items-center gap-1.5">
                  {entry.title}
                  <span class="text-green-600 dark:text-green-400">✓</span>
                </span>
              </li>
            ) : (
              <li class="text-zinc-700 dark:text-zinc-300">
                <a href={entry.href} class="hover:text-zinc-900 dark:hover:text-zinc-100 no-underline hover:underline">
                  {entry.title}
                </a>
              </li>
            )
          )}
        </ol>
        <div class="flex justify-end mt-2">
          <a href={`/series/${seriesName}/`} class="text-sm no-underline hover:underline">
            View full series &rarr;
          </a>
        </div>
      </div>
    </aside>
  )
}
