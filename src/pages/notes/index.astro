---
import NotePreview from '@components/NotePreview.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { getPublishedNotes } from '@lib/utils';

const notes = await getPublishedNotes();
---

<BaseLayout
  title="Notes | Josh Finnie"
  description="Short notes, snippets, and gists worth remembering, on Rust, Go, Python, JavaScript, and the command line."
>
  <div class="flex flex-col gap-2 mb-8">
    <h1 class="text-3xl font-bold tracking-tight text-zinc-800 dark:text-zinc-100">Notes</h1>
    <p class="text-base text-zinc-600 dark:text-zinc-400">
      Small gists and snippets I want to remember. Shorter and rougher than the{" "}
      <a href="/blog/" class="text-teal-500 hover:text-teal-600 dark:text-teal-400 dark:hover:text-teal-300 transition">
        blog
      </a>, but often more useful. There's an{" "}
      <a
        href="/notes/rss.xml"
        class="text-teal-500 hover:text-teal-600 dark:text-teal-400 dark:hover:text-teal-300 transition"
      >
        RSS feed
      </a>{" "}
      just for these.
    </p>
  </div>
  <section id="main-content" aria-label="Notes">
    {
      notes.length > 0 ? (
        notes.map((note) => (
          <Fragment key={note.id}>
            <NotePreview id={note.id} />
          </Fragment>
        ))
      ) : (
        <p class="text-base text-zinc-600 dark:text-zinc-400">No notes yet. Check back soon!</p>
      )
    }
  </section>
</BaseLayout>
